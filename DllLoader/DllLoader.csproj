<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<Version>0.0.0</Version>
		<Authors>Rube200</Authors>
		<Company>Rube200-Devs</Company>
		<RepositoryType>Public</RepositoryType>
		<RepositoryUrl>https://github.com/rube200/Oxide.Ext.DllLoader</RepositoryUrl>
		<RootNamespace>Oxide.Ext.DllLoader</RootNamespace>
		<AssemblyName>Carbon.Ext.DllLoader</AssemblyName>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<!--
		  Выход: bin\<Config>\net48\ (+ copy-local зависимости).
		  В расширения Carbon копируется только Carbon.Ext.DllLoader.dll ($(TargetPath)), без прочих DLL и без .pdb.
		  Release без символов: ни .pdb в bin рядом с этим проектом.
		  Отключить копирование: -p:SkipCarbonExtensionsDeploy=true
		  Путь: -p:CarbonExtensionsDeployDir=...
		-->
		<!--
		  Деплой в Carbon extensions включён по умолчанию.
		  Отключить: -p:SkipCarbonExtensionsDeploy=true
		  Изменить путь: -p:CarbonExtensionsDeployDir=...
		-->
		<SkipCarbonExtensionsDeploy Condition="'$(SkipCarbonExtensionsDeploy)' == ''">false</SkipCarbonExtensionsDeploy>
		<CarbonExtensionsDeployDir Condition="'$(CarbonExtensionsDeployDir)' == ''">G:\rustserver-carbon\server\carbon\extensions</CarbonExtensionsDeployDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Update="Library.Packages.Carbon" Version="2026.5.8.1515" />
	</ItemGroup>

	<Target Name="DeployCarbonDllLoaderDllOnly"
	        AfterTargets="Build"
	        Condition="'$(SkipCarbonExtensionsDeploy)' != 'true' And '$(CarbonExtensionsDeployDir)' != ''">
		<MakeDir Directories="$(CarbonExtensionsDeployDir)" ContinueOnError="WarnAndContinue" />
		<Copy SourceFiles="$(TargetPath)"
		      DestinationFolder="$(CarbonExtensionsDeployDir)"
		      SkipUnchangedFiles="true"
		      ContinueOnError="WarnAndContinue" />
	</Target>

</Project>
